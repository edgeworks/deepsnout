# Copy to .env only to change defaults. No passwords here.
# Headless deployments publish on all host interfaces by default. Set a specific
# address (or 127.0.0.1) to restrict the Docker port binding.
DEEPSNOUT_BIND_ADDRESS=0.0.0.0
DEEPSNOUT_PORT=8080
# Add the IP address and/or DNS name analysts will use. Keep localhost for the
# container health check. No wildcard is accepted.
DEEPSNOUT_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],192.0.2.10,deepsnout.example.org
# Set 1 only behind a trusted HTTPS endpoint.
DEEPSNOUT_SECURE_COOKIES=0
