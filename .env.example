# Copy to .env. No passwords or private keys belong here.
#
# For a headless deployment, set this to the ONE DNS name or IP address that
# analysts will use in the browser. Caddy issues the bootstrap certificate for
# exactly this name/address. Use brackets for an IPv6 literal.
DEEPSNOUT_PUBLIC_HOST=localhost

# Extra Host-header aliases accepted by the application itself. The public host
# above is added automatically. These aliases do NOT receive additional TLS
# certificates in the initial Caddy configuration.
DEEPSNOUT_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# The bundled Caddy endpoint is HTTPS, so secure cookies are the deployment
# default. Set 0 only for intentional direct HTTP development outside Compose.
DEEPSNOUT_SECURE_COOKIES=1
